{
  "info": {
    "_postman_id": "b7891234-5678-4321-9876-abcdef012345",
    "name": "PIM Tool API Collection",
    "description": "Complete REST API Test Collection for PIM Tool (Pilot Project). Ready to import into Bruno or Postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Happy Paths",
      "description": "Standard successful API requests (200 OK, 201 Created, 204 No Content)",
      "item": [
        {
          "name": "1. Get all employees",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/employees",
              "host": ["{{baseUrl}}"],
              "path": ["employees"]
            },
            "description": "Retrieve list of all employees to populate Member Visas dropdown / chips."
          }
        },
        {
          "name": "2. Get all groups",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/groups",
              "host": ["{{baseUrl}}"],
              "path": ["groups"]
            },
            "description": "Retrieve list of all groups with leader details to populate Group dropdown."
          }
        },
        {
          "name": "3. Search projects (Keyword & Status)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/projects/search?keyword=EFV&status=NEW",
              "host": ["{{baseUrl}}"],
              "path": ["projects", "search"],
              "query": [
                {
                  "key": "keyword",
                  "value": "EFV"
                },
                {
                  "key": "status",
                  "value": "NEW"
                }
              ]
            },
            "description": "Search projects by keyword (Project Number / Name / Customer) and status."
          }
        },
        {
          "name": "4. Get project by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/projects/1",
              "host": ["{{baseUrl}}"],
              "path": ["projects", "1"]
            },
            "description": "Retrieve detailed information of project with ID 1 to populate Edit form."
          }
        },
        {
          "name": "5. Create project successfully",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectNumber\": 8888,\n  \"name\": \"Bruno Pilot Project\",\n  \"customer\": \"ELCA Vietnam\",\n  \"groupId\": 1,\n  \"status\": \"NEW\",\n  \"startDate\": \"2026-09-01\",\n  \"endDate\": \"2026-12-31\",\n  \"memberVisas\": [\"DTH\", \"BHU\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/projects",
              "host": ["{{baseUrl}}"],
              "path": ["projects"]
            },
            "description": "Create a new project with valid fields. Expected: 201 Created."
          }
        },
        {
          "name": "6. Update project successfully",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectNumber\": 1001,\n  \"name\": \"EFV Core Banking - Updated\",\n  \"customer\": \"EFV\",\n  \"groupId\": 1,\n  \"status\": \"NEW\",\n  \"startDate\": \"2021-01-01\",\n  \"version\": 0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/projects/1",
              "host": ["{{baseUrl}}"],
              "path": ["projects", "1"]
            },
            "description": "Update project with ID 1 successfully. Expected: 200 OK and version increments to 1."
          }
        },
        {
          "name": "7. Delete project with status NEW",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  5\n]"
            },
            "url": {
              "raw": "{{baseUrl}}/projects",
              "host": ["{{baseUrl}}"],
              "path": ["projects"]
            },
            "description": "Delete project with ID 5 (status NEW). Expected: 204 No Content."
          }
        }
      ]
    },
    {
      "name": "02 - Error Scenarios (Test GlobalExceptionHandler)",
      "description": "Scenarios to verify exception handling in GlobalExceptionHandler (400, 404, 409)",
      "item": [
        {
          "name": "1. [Error 404] Project Not Found",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/projects/99999",
              "host": ["{{baseUrl}}"],
              "path": ["projects", "99999"]
            },
            "description": "Query non-existent project ID. Expected: 404 Not Found (error: RESOURCE_NOT_FOUND)."
          }
        },
        {
          "name": "2. [Error 400] Duplicate Project Number (ProjectNumberAlreadyException)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectNumber\": 1001,\n  \"name\": \"Duplicate Project Number\",\n  \"customer\": \"Customer X\",\n  \"groupId\": 1,\n  \"status\": \"NEW\",\n  \"startDate\": \"2026-09-01\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/projects",
              "host": ["{{baseUrl}}"],
              "path": ["projects"]
            },
            "description": "Project number 1001 already exists in database. Expected: 400 Bad Request (error: PROJECT_NUMBER_ALREADY_EXISTED)."
          }
        },
        {
          "name": "3. [Error 400] Blank Project Name (IllegalArgumentException)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectNumber\": 8892,\n  \"name\": \"   \",\n  \"customer\": \"Customer Y\",\n  \"groupId\": 1,\n  \"status\": \"NEW\",\n  \"startDate\": \"2026-09-01\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/projects",
              "host": ["{{baseUrl}}"],
              "path": ["projects"]
            },
            "description": "Project name is mandatory and cannot be blank. Expected: 400 Bad Request (message: Project Name is mandatory)."
          }
        },
        {
          "name": "4. [Error 400] End date before start date",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectNumber\": 8893,\n  \"name\": \"Invalid Date Project\",\n  \"customer\": \"Customer Z\",\n  \"groupId\": 1,\n  \"status\": \"NEW\",\n  \"startDate\": \"2026-12-31\",\n  \"endDate\": \"2026-01-01\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/projects",
              "host": ["{{baseUrl}}"],
              "path": ["projects"]
            },
            "description": "Validation for end date before start date. Expected: 400 Bad Request (message: End date must be after or equal to Start date)."
          }
        },
        {
          "name": "5. [Error 400] Employee VISA not found (EmployeeVisaNotFoundException)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectNumber\": 8894,\n  \"name\": \"Non-existing Visa Project\",\n  \"customer\": \"Customer W\",\n  \"groupId\": 1,\n  \"status\": \"NEW\",\n  \"startDate\": \"2026-09-01\",\n  \"memberVisas\": [\"DTH\", \"UNKNOWN_VISA_XYZ\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/projects",
              "host": ["{{baseUrl}}"],
              "path": ["projects"]
            },
            "description": "Visa UNKNOWN_VISA_XYZ does not exist in system. Expected: 400 Bad Request (error: EMPLOYEE_VISA_NOT_FOUND)."
          }
        },
        {
          "name": "6. [Error 400] Change project number in edit mode",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectNumber\": 9999,\n  \"name\": \"Attempt Change Number\",\n  \"customer\": \"EFV\",\n  \"groupId\": 1,\n  \"status\": \"NEW\",\n  \"startDate\": \"2021-01-01\",\n  \"version\": 0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/projects/1",
              "host": ["{{baseUrl}}"],
              "path": ["projects", "1"]
            },
            "description": "Project ID 1 has number 1001; attempting to change to 9999 is invalid. Expected: 400 Bad Request (message: Project number cannot be changed in edit mode)."
          }
        },
        {
          "name": "7. [Error 400] Delete project not in NEW status (InvalidProjectStatusForDeletionException)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  2\n]"
            },
            "url": {
              "raw": "{{baseUrl}}/projects",
              "host": ["{{baseUrl}}"],
              "path": ["projects"]
            },
            "description": "Project ID 2 has status 'PLA' (Planned). Only NEW projects can be deleted. Expected: 400 Bad Request (error: INVALID_PROJECT_STATUS_FOR_DELETION)."
          }
        },
        {
          "name": "8. [Error 409] Optimistic Locking conflict (Concurrent Update)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectNumber\": 1001,\n  \"name\": \"EFV Concurrent Conflict Stale Version\",\n  \"customer\": \"EFV\",\n  \"groupId\": 1,\n  \"status\": \"NEW\",\n  \"startDate\": \"2021-01-01\",\n  \"version\": 0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/projects/1",
              "host": ["{{baseUrl}}"],
              "path": ["projects", "1"]
            },
            "description": "After request '6. Update project successfully' has run (version in DB incremented to 1), send this request with version = 0. Expected: 409 Conflict (error: CONCURRENT_UPDATE_CONFLICT)."
          }
        }
      ]
    }
  ]
}
